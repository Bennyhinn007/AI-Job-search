# ===== Adzuna API (primary job source) =====
# Register for free at https://developer.adzuna.com/ to get these.
# If left blank, the app still runs using the keyless Remotive source.
ADZUNA_APP_ID=c6b52cea
ADZUNA_APP_KEY=71e06ecce45d85b981c4a7ae26cbec93

# ===== Email (Gmail SMTP) =====
# EMAIL_ADDRESS: the Gmail account that sends the digest.
# EMAIL_PASSWORD: a 16-character Gmail App Password (NOT your normal password).
#   See README "Gmail App Password setup".
# RECIPIENT_EMAIL: where the digest is delivered (can be the same as EMAIL_ADDRESS).
# Not required for --dry-run.
EMAIL_ADDRESS=bennysangnalkar@gmail.com
EMAIL_PASSWORD=heje spkv mlyh bran
RECIPIENT_EMAIL=bennyhinn.icb@gmail.com

# ===== Optional LLM matching =====
# If a key is set, the app attempts richer LLM-based resume<->JD matching.
# On any failure it automatically falls back to keyword matching.
# Provider preference: Gemini (Google) first, then OpenAI, then keyword.
#
# Option A: Google Gemini (has a free tier). Get a key at:
#   https://aistudio.google.com/app/apikey
#   then: pip install google-generativeai
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
#
# Option B: OpenAI (paid). Get a key at https://platform.openai.com/api-keys
#   then: pip install openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Tuning =====
MAX_JOB_AGE_DAYS=1
MIN_MATCH_SCORE=60
MAX_EMAIL_JOBS=10

# Recommendation thresholds (match score cutoffs)
APPLY_THRESHOLD=80
CONSIDER_THRESHOLD=60

# Country for Adzuna (ISO code: in=India, gb, us, etc.)
ADZUNA_COUNTRY=in

# Ranking boost order; earlier = higher priority. Comma separated.
LOCATION_PRIORITY=Bengaluru,Hyderabad,Pune,Chennai,Mumbai,Delhi NCR,Remote
